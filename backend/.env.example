# Copy this file to .env and adjust as needed (all optional - sensible defaults exist).
# This server has zero npm dependencies, so `.env` is loaded by a tiny built-in
# loader in src/env.js - no dotenv package required.

PORT=4000

# HMAC secret used to sign auth tokens. Change this for anything beyond local dev.
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Token lifetime in days.
JWT_EXPIRES_DAYS=30

# Where the JSON "database" file is stored. On a hosting platform with an
# ephemeral filesystem (most free tiers), point this at a mounted
# persistent disk instead, e.g. DB_PATH=/data/sparkr.json on Render - see
# DEPLOY.md - otherwise every restart/redeploy wipes all registered users.
DB_PATH=./data/sparkr.json

# Where uploaded photos/voice notes are stored (see src/uploads-dir.js).
# Same rule as DB_PATH above: point this at the same persistent disk in
# production, e.g. UPLOAD_DIR=/data/uploads, so uploaded files survive
# restarts too - a stale DB entry pointing at a wiped file is worse than
# both being wiped together.
UPLOAD_DIR=./data/uploads

# Comma separated list of allowed CORS origins, or * for all (dev default).
CORS_ORIGIN=*

# Rate limiting (see src/rate-limit.js) keys buckets by client IP. Leave this
# false (default) when running directly, e.g. locally or in this sandbox -
# anyone could otherwise spoof X-Forwarded-For to dodge the limit. Set to
# true ONLY if this server runs behind a reverse proxy/load balancer (nginx,
# a cloud LB, etc.) that you control and that overwrites X-Forwarded-For
# itself - otherwise this setting makes rate limiting worse, not better.
# On a platform like Render/Railway/Fly.io this should be TRUE - their edge
# proxy is the trusted layer setting X-Forwarded-For, not an attacker.
TRUST_PROXY=false

# Needed for "Google ile devam et" (see src/routes/auth.js -> /api/auth/google
# and src/google-verify.js). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials and use its Client ID
# here - it must match whichever client ID the mobile app requests an ID
# token with (see mobile/.env.example). Leave empty to keep Google sign-in
# disabled; the endpoint will return a clear error instead of failing silently.
GOOGLE_CLIENT_ID=

# Needed for "Facebook ile devam et" (see src/routes/auth.js ->
# /api/auth/facebook and src/facebook-verify.js). Create an app at
# https://developers.facebook.com/apps -> add the "Facebook Login" product ->
# Settings -> Basic gives you the App ID and App Secret below. Under
# Facebook Login -> Settings, add your app's OAuth redirect URI (see
# mobile/.env.example) to "Valid OAuth Redirect URIs". The "public_profile"
# and "email" permissions used here are both pre-approved for any app in
# Live mode - no App Review needed to launch with just this. Leave both
# empty to keep Facebook sign-in disabled; the endpoint will return a clear
# error instead of failing silently.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Content moderation for photos/voice notes/chat text (see src/moderation.js,
# wired into POST /api/uploads and POST /api/matches/:id/messages). Both of
# the vars below are OPTIONAL and PAID - leave either empty to skip that one
# check (uploads/messages still go through, just unmoderated for that type;
# a warning is logged once). The text word-list filter has no dependency and
# always runs regardless of these.

# Paste the ENTIRE service account key JSON (from a GCP project with the
# Cloud Vision API enabled - console.cloud.google.com/apis/library/vision.googleapis.com
# -> IAM & Admin -> Service Accounts -> Keys -> Add Key -> JSON) as ONE line
# here. Used for SafeSearch image moderation. Pricing (as of writing): first
# 1,000 images/month free, then $1.50/1,000 - see cloud.google.com/vision/pricing.
GOOGLE_SERVICE_ACCOUNT_JSON=

# platform.openai.com API key, used only to transcribe voice notes (Whisper)
# so the spoken words can run through the same text filter. Pricing (as of
# writing): $0.006/minute - see platform.openai.com/docs/pricing.
OPENAI_API_KEY=
